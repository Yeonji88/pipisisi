{
  "name": "nyam-recipe-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test": "node --test tests/*.test.mjs functions/test/*.test.cjs",
    "test:rules": "npx --yes --package firebase-tools@15.32.1 firebase emulators:exec --only firestore --project demo-nyam-push \"node --test tests/emulator/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "8.0.3",
    "firebase": "12.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "0.28.2"
  }
}
