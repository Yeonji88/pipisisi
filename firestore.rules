rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/pushTokens/{installationId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read, delete: if owner();
      allow create, update: if owner()
        && installationId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
    }
    match /pushDeliveries/{id} { allow read, write: if false; }
    match /pushReceipts/{id} { allow read, write: if false; }
    match /chatThreads/{threadId} {
      function member() { return request.auth != null && request.auth.uid in resource.data.members; }
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/chatThreads/$(threadId)) || member());
      allow list: if member();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members','initiatorUid','initiatorCode','targetCode','createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.initiatorUid == request.auth.uid
        && get(/databases/$(database)/documents/recipeShares/$(request.resource.data.initiatorCode)).data.ownerUid == request.auth.uid
        && request.resource.data.members.hasAll([request.auth.uid, get(/databases/$(database)/documents/recipeShares/$(request.resource.data.targetCode)).data.ownerUid])
        && get(/databases/$(database)/documents/recipeShares/$(request.resource.data.targetCode)).data.ownerUid != request.auth.uid
        && request.resource.data.createdAt == request.time;
      match /chatMessages/{messageId} {
        function participant() { return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chatThreads/$(threadId)).data.members; }
        allow get: if participant() && resource.data.expiresAt > request.time;
        allow list: if participant() && resource.data.expiresAt > request.time && request.query.limit <= 100;
        allow create: if participant()
          && request.resource.data.keys().hasOnly(['senderUid','text','sentAt','expiresAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt is timestamp
          && request.resource.data.sentAt <= request.time + duration.value(30,'s')
          && request.resource.data.sentAt >= request.time - duration.value(2,'m')
          && request.resource.data.expiresAt <= request.time + duration.value(24,'h')
          && request.resource.data.expiresAt == request.resource.data.sentAt + duration.value(24,'h');
      }
    }
    match /users/{uid}/settings/profile {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 30
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/settings/sharing {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code','createdAt'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[a-f0-9]{32}$')
        && request.resource.data.createdAt == request.time;
    }
    match /recipeShares/{code} {
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt','displayName','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 30
        && request.resource.data.updatedAt == request.time;
      // 코드를 아는 로그인 사용자만 직접 접근하며 전체 코드 목록은 공개하지 않는다.
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      match /recipes/{recipeId} {
        function shareOwner() {
          return request.auth != null && get(/databases/$(database)/documents/recipeShares/$(code)).data.ownerUid == request.auth.uid;
        }
        allow read: if request.auth != null;
        allow delete: if shareOwner();
        allow create, update: if shareOwner()
          && request.resource.data.keys().hasOnly(['id','name','emoji','category','servings','ingredients','steps','memo','favorite','photo','recipeDate','updatedAt'])
          && request.resource.data.id == recipeId
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
          && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 100
          && request.resource.data.category is string && request.resource.data.category.size() <= 100
          && request.resource.data.servings is number && request.resource.data.servings >= 1 && request.resource.data.servings <= 10000
          && request.resource.data.ingredients is string && request.resource.data.ingredients.size() <= 20000
          && request.resource.data.steps is string && request.resource.data.steps.size() <= 40000
          && request.resource.data.memo == '' && request.resource.data.favorite == false
          && request.resource.data.photo is string && request.resource.data.photo.size() <= 600000
          && request.resource.data.recipeDate is string && request.resource.data.recipeDate.size() <= 10
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /users/{uid}/recipes/{recipeId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id','name','emoji','category','servings','ingredients','steps','memo','favorite','photo','revision','deleted','updatedAt','recipeDate'])
          && (!('recipeDate' in d) || (d.recipeDate is string && (d.recipeDate == '' || d.recipeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
          && d.id == recipeId && d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.emoji is string && d.emoji.size() <= 100 && d.category is string && d.category.size() <= 100
          && d.servings is number && d.servings >= 1 && d.servings <= 10000
          && d.ingredients is string && d.ingredients.size() <= 20000
          && d.steps is string && d.steps.size() <= 40000
          && d.memo is string && d.memo.size() <= 20000
          && d.favorite is bool && d.photo is string && d.photo.size() <= 600000
          && d.deleted is bool && d.revision is int && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      // 삭제도 버전이 있는 문서로 보관해 다른 기기의 오래된 수정으로 복구되지 않게 한다.
      allow delete: if false;
    }
  }
}
